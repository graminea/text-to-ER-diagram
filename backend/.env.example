# Copy to backend/.env, then launch uvicorn with --env-file .env.
# Never commit .env or put the API key in the browser.
MODE=llm
# Use a model ID available in your provider account, with its LiteLLM prefix:
# openai/<model>, gemini/<model>, anthropic/<model>, deepseek/<model>, etc.
MODEL=
API_KEY=
TIMEOUT=60
MAX_TOKENS=4096
OUTPUT_MODE=json_schema
# Explicit compatibility option for models without JSON Schema: json_object.
# No automatic fallback, correction, agents or retries are performed.
# Optional, for an OpenAI-compatible service or a local gateway:
# API_BASE=http://localhost:1234/v1
